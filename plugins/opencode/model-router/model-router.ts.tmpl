  return {
    "chat.message": async (input, output) => {
      const agent = (input as { agent?: string }).agent;
      const want = agent && ROUTING[agent];
      if (!agent || !want) return;
      const split = splitModel(want);
      if (!split) {
        await log("warn", `ROUTING entry malformed for agent ${agent}`, { want });
        return;
      }
      const msg = (output as { message?: { model?: { providerID?: string; modelID?: string } } }).message;
      if (!msg?.model) return;
      const before = `${msg.model.providerID}/${msg.model.modelID}`;
      if (before !== want) {
        msg.model.providerID = split.providerID;
        msg.model.modelID = split.modelID;
      }
      await log("info", "model selected", {
        sessionID: (input as { sessionID?: string }).sessionID,
        agent,
        requestedModel: before,
        actualModel: want,
      });
    },
    "tool.execute.before": async (input, output) => {
      if ((input as { tool?: string }).tool !== "task") return;
      const name = (output as { args?: { subagent_type?: string } }).args?.subagent_type;
      if (!name) return;
      const want = ROUTING[name];
      await log(want ? "info" : "warn", want ? "task delegated" : "unknown subagent", {
        sessionID: (input as { sessionID?: string }).sessionID,
        agent: name,
        model: want,
      });
    },
  };
}) as Plugin;
