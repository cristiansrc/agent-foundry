// NOTE: zero-dependency artifact on purpose. The V2 SDK (`@opencode/plugin`)
// is NOT resolvable from ~/.config/opencode/plugins/ (no node_modules
// there), so this file must not import it. `Plugin.define` is only a typed
// wrapper; a plain default-exported { id, setup } object satisfies the V2
// loader ("a default definition with an id and an effect or setup function").
// Keep it import-free so `sync` stays a plain file copy.

// GENERATED by agent-foundry (adapters/shared/render.py::render_plugin).
// DO NOT EDIT: source is plugins/opencode/model-router/model-router.ts.tmpl
// + profiles/models.yaml. Rebuild with ./tooling/build.sh (or sync.ps1).
//
// ROUTING maps agent name -> "provider/model-id" resolved at build time.
//
// V2 notes:
// - Static model enforcement via message rewriting is obsolete: a V2 subagent
//   uses its agent file's `model:` (rendered from ROUTING), or inherits the
//   parent model when none is configured. This plugin therefore only observes
//   static routing (log) and applies Jev dynamic *agent* selection.
// - The spawn tool is `subagent` in V2 (was `task` in V1).
// - Model-per-reasoning-level cannot be forced through V2 hooks; the selected
//   subagent runs its configured model. reasoning_models stays in the payload
//   for observability only.

const ROUTING: Record<string, string> = __ROUTING_JSON__;
const JEV_CONFIG = __JEV_CONFIG_JSON__ as {
  provider: string;
  providers: Record<string, { base_url: string; model: string; api_key_env: string }>;
  confidence: { auto_route: number; confirm: number };
  dynamic_agents: string[];
  reasoning_models: Record<string, string>;
};

function log(level: "info" | "warn", message: string, extra?: Record<string, unknown>) {
  try {
    if (extra) console.log(`[foundry-model-router] [${level}] ${message}`, JSON.stringify(extra));
    else console.log(`[foundry-model-router] [${level}] ${message}`);
  } catch {
    // observability must never break routing
  }
}

async function askJev(state: unknown) {
  const provider = JEV_CONFIG.providers[JEV_CONFIG.provider];
  const key = provider && process.env[provider.api_key_env];
  if (!provider || !key) return null;
  const questions = {
    next_agent: {
      type: "choice",
      instructions: "Choose the next authorized Agent Foundry agent for this task.",
      criteria: Object.fromEntries(JEV_CONFIG.dynamic_agents.map((name) => [name, name])),
    },
    reasoning_level: {
      type: "choice",
      instructions: "Choose the minimum reasoning level needed: low, medium, high, or critical.",
      criteria: {
        low: "Mechanical or fully specified work",
        medium: "Several dependencies or moderate interpretation",
        high: "Architecture, security, RCA, or high-impact decisions",
        critical: "Irreversible or highly consequential decisions",
      },
    },
    needs_human_clarification: {
      type: JEV_CONFIG.provider === "vercel" ? "boolean" : "noul",
      instructions: "Does the task require a human decision before routing?",
    },
  };
  try {
    const response = await fetch(provider.base_url, {
      method: "POST",
      headers: { Authorization: `Bearer ${key}`, "Content-Type": "application/json" },
      body: JSON.stringify({ model: provider.model, state, questions }),
    });
    if (!response.ok) return null;
    const payload = (await response.json()) as { answers?: Record<string, any>; data?: { answers?: Record<string, any> } };
    const answers = payload.answers ?? payload.data?.answers ?? {};
    const agent = answers.next_agent?.choice;
    const reasoning = answers.reasoning_level?.choice;
    const confidence = Math.min(
      answers.next_agent?.confidence ?? answers.next_agent?.probability ?? 0,
      answers.reasoning_level?.confidence ?? answers.reasoning_level?.probability ?? 0,
    );
    const humanProbability = answers.needs_human_clarification?.noul ?? answers.needs_human_clarification?.probability ?? 0;
    if (!agent || !reasoning || !JEV_CONFIG.dynamic_agents.includes(agent)) return null;
    return { agent, reasoning, confidence, needsHuman: humanProbability >= 0.5 };
  } catch {
    return null;
  }
}

function requestedSubagent(input: unknown): string | null {
  const args = (input as { input?: Record<string, unknown> })?.input
    ?? (input as { args?: Record<string, unknown> })?.args
    ?? (input as Record<string, unknown>);
  if (!args || typeof args !== "object") return null;
  for (const key of ["subagent_type", "subagent", "agent"]) {
    const value = (args as Record<string, unknown>)[key];
    if (typeof value === "string" && value.length > 0) return value;
  }
  return null;
}

function setRequestedSubagent(input: unknown, name: string): void {
  const holder = (input as { input?: Record<string, unknown> })?.input
    ?? (input as { args?: Record<string, unknown> })?.args
    ?? (input as Record<string, unknown>);
  if (!holder || typeof holder !== "object") return;
  if (typeof (holder as Record<string, unknown>)["subagent_type"] === "string") {
    (holder as Record<string, unknown>)["subagent_type"] = name;
  } else if (typeof (holder as Record<string, unknown>)["subagent"] === "string") {
    (holder as Record<string, unknown>)["subagent"] = name;
  } else if (typeof (holder as Record<string, unknown>)["agent"] === "string") {
    (holder as Record<string, unknown>)["agent"] = name;
  }
}

interface FoundryPluginContext {
  location: { directory: string };
  tool: {
    hook(event: "execute.before", handler: (e: Record<string, any>) => void | Promise<void>): Promise<unknown>;
  };
}

const FoundryModelRouterPlugin = {
  id: "foundry-model-router",
  async setup(ctx: FoundryPluginContext) {
    log("info", `loaded with ${Object.keys(ROUTING).length} static routes`, {
      directory: ctx.location.directory,
    });

    await ctx.tool.hook("execute.before", async (event: Record<string, any>) => {
      try {
        const tool = (event as { tool?: string }).tool ?? "";
        if (tool !== "subagent" && tool !== "task") return;
        const name = requestedSubagent(event);
        if (!name) return;

        if (JEV_CONFIG.dynamic_agents.includes(name)) {
          const input = (event as { input?: unknown }).input ?? event;
          const prompt = ((input as Record<string, unknown>)?.["prompt"]
            ?? (input as Record<string, unknown>)?.["description"]
            ?? "") as string;
          const decision = await askJev({
            task: prompt,
            requested_agent: name,
            available_agents: JEV_CONFIG.dynamic_agents,
            policy: "Agent Foundry gates and permissions are authoritative.",
          });
          if (decision && !decision.needsHuman && decision.confidence >= JEV_CONFIG.confidence.auto_route) {
            setRequestedSubagent(event, decision.agent);
            log("info", `jev reroute ${name} -> ${decision.agent}`, {
              reasoning: decision.reasoning,
              confidence: decision.confidence,
            });
            return;
          }
          log("info", `jev decision for subagent -> ${decision?.agent ?? name} (kept ${name})`, {
            confidence: decision?.confidence,
            reasoning: decision?.reasoning,
            needsHuman: decision?.needsHuman,
          });
        }

        const want = ROUTING[name];
        if (!want) {
          log("warn", `subagent delegating to unknown agent ${name}`);
          return;
        }
        log("info", `subagent -> ${name} should run ${want} (agent file model)`);
      } catch {
        // observability and routing must never throw
      }
    });
  },
};

export default FoundryModelRouterPlugin;
